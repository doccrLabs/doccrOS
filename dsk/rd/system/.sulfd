var gui = 1

var desktop = ("/users/pc/applications/desktop/desktop.elf")
var welcome = ("/users/pc/applications/desktop/welcome.elf")
var login   = ("/users/pc/applications/desktop/login.elf")

print(
    "=> succesfully jumped into userspace... yay :3"
)

wait 5

if gui == 1
    exec desktop

    wait  15 // after desktop has succesfully loaded

    exec login
ef
    var x1 = ("/system/x1.elf")
    print(
        ":: warning gui not activated"
    )
    exec x1
fi
